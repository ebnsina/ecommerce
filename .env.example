# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL="postgres://user:password@localhost:5432/ecommerce"

# ── File storage ────────────────────────────────────────────────────────
# local  — writes to static/uploads. Fine for dev and a VPS with a real disk.
# s3     — any S3-compatible bucket: Cloudflare R2, MinIO, Spaces, Wasabi, S3.
#          REQUIRED on serverless hosts: their filesystem is ephemeral.
STORAGE_DRIVER="local"
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION="auto"
S3_PUBLIC_URL=          # CDN or public bucket domain used for reads
S3_VIRTUAL_HOST="false" # true for AWS bucket-in-hostname addressing
UPLOAD_MAX_BYTES="5242880"

# ── SMS gateway ─────────────────────────────────────────────────────────
# Without these, codes and notifications are logged to the server console.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ── AI assistant ────────────────────────────────────────────────────────
AI_PROVIDER="anthropic"   # anthropic | openai | ollama
AI_MODEL=                 # optional override
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Inbox channels ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
META_PAGE_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=

# ── Courier ─────────────────────────────────────────────────────────────
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=      # override only for a sandbox

# ── Scheduled jobs ──────────────────────────────────────────────────────
# Two jobs need calling on a schedule. They are ordinary HTTP endpoints that
# take GET or POST, so anything can drive them — a crontab line, a systemd
# timer, a CI schedule, an uptime pinger:
#
#   0  * * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://your-shop/api/cron/courier-sync
#   30 * * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://your-shop/api/cron/abandoned-carts
#
# Both are safe to run twice or to miss: a cart reminder is claimed before it is
# sent, and courier sync only ever reconciles with what the courier reports.
CRON_SECRET=

# ── Seeding ─────────────────────────────────────────────────────────────
SEED_EMAIL="owner@store.test"
SEED_PASSWORD="changeme123"

# --- Pathao courier -----------------------------------------------------------
# From your Pathao merchant panel. The store id is the pickup store the parcel
# leaves from. Pathao delivers by its own city/zone/area ids, which are matched
# from each order's address by name.
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
# 1 points at Pathao's sandbox rather than the live courier.
PATHAO_SANDBOX="1"
# 48 = normal delivery, 12 = same day. Weight is in kilograms.
PATHAO_DELIVERY_TYPE="48"
PATHAO_ITEM_WEIGHT="0.5"

# --- Online payment -----------------------------------------------------------
# SSLCommerz: cards, bKash, Nagad, Rocket and internet banking on one page.
# Leave blank and the shop takes cash on delivery only. Set the IPN URL in your
# SSLCommerz panel to https://your-shop/api/payments/sslcommerz/ipn
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# 1 while testing, so nothing hits the live gateway.
SSLCOMMERZ_SANDBOX="1"

# --- Search -------------------------------------------------------------------
# Optional. Without it the shop searches the database directly, which matches
# only exactly what a shopper types. Typesense Cloud gives you these four.
TYPESENSE_HOST=
TYPESENSE_PORT="443"
TYPESENSE_PROTOCOL="https"
TYPESENSE_API_KEY=

# --- AI reply assistant -------------------------------------------------------
# anthropic | openai | groq | ollama. Groq speaks the OpenAI protocol at its own
# address, so it needs no extra package — just the key.
AI_PROVIDER="groq"
GROQ_API_KEY=
# Optional. Defaults per provider; on Groq that is openai/gpt-oss-20b.
# openai/gpt-oss-120b or llama-3.3-70b-versatile give better answers.
AI_MODEL=

# --- Meta ads tracking -------------------------------------------------------
# The pixel ID itself is public and lives in Settings → Facebook ads tracking.
# This token is the secret half, used for server-side events (Conversions API).
# Events Manager → Settings → Generate access token.
META_CAPI_TOKEN=
# Set while testing so events show under Test Events instead of live reporting.
META_TEST_EVENT_CODE=
