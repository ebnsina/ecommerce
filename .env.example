# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL="postgres://user:password@localhost:5432/ecommerce"

# ── File storage ────────────────────────────────────────────────────────
# local  — writes to static/uploads. Fine for dev and a VPS with a real disk.
# s3     — any S3-compatible bucket: Cloudflare R2, MinIO, Spaces, Wasabi, S3.
#          REQUIRED on serverless hosts: their filesystem is ephemeral.
STORAGE_DRIVER="local"
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION="auto"
S3_PUBLIC_URL=          # CDN or public bucket domain used for reads
S3_VIRTUAL_HOST="false" # true for AWS bucket-in-hostname addressing
UPLOAD_MAX_BYTES="5242880"

# ── SMS gateway ─────────────────────────────────────────────────────────
# Without these, codes and notifications are logged to the server console.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ── AI assistant ────────────────────────────────────────────────────────
AI_PROVIDER="anthropic"   # anthropic | openai | ollama
AI_MODEL=                 # optional override
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Inbox channels ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
META_PAGE_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=

# ── Courier ─────────────────────────────────────────────────────────────
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=      # override only for a sandbox

# ── Scheduled jobs ──────────────────────────────────────────────────────
# POST /api/cron/courier-sync with: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# ── Seeding ─────────────────────────────────────────────────────────────
SEED_EMAIL="owner@store.test"
SEED_PASSWORD="changeme123"

# --- Meta ads tracking -------------------------------------------------------
# The pixel ID itself is public and lives in Settings → Facebook ads tracking.
# This token is the secret half, used for server-side events (Conversions API).
# Events Manager → Settings → Generate access token.
META_CAPI_TOKEN=
# Set while testing so events show under Test Events instead of live reporting.
META_TEST_EVENT_CODE=
