{
	"name": "ecommerce",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5199 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 5199 --strictPort",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node --env-file=.env scripts/seed.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/mona-sans": "^5.3.0",
		"@fontsource-variable/noto-sans-bengali": "^5.3.0",
		"@icons-pack/svelte-simple-icons": "^7.2.0",
		"@lucide/svelte": "^1.41.0",
		"@tanstack/ai": "^0.53.0",
		"@tanstack/ai-anthropic": "^0.18.5",
		"@tanstack/ai-ollama": "^0.11.1",
		"@tanstack/ai-openai": "^0.22.5",
		"@tanstack/ai-svelte": "^0.21.0",
		"@tanstack/pacer": "^0.22.0",
		"@tanstack/svelte-table": "^9.2.4",
		"@tiptap/core": "^3.31.3",
		"@tiptap/extension-link": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"aws4fetch": "^1.0.20",
		"driver.js": "^1.8.0",
		"postgres": "^3.4.9",
		"typesense": "^3.0.6"
	}
}
